# Copia este ficheiro para .env e preenche com valores reais.
# Nenhum destes valores é real — é só a lista do que a app precisa.

# Base de dados
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tesouraria
DB_USER=postgres
DB_PASSWORD=

# Autenticação — gera uma chave forte, ex: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ALGORITMO_JWT=HS256
TOKEN_DIAS=30

# Email (recuperação de password) — password de aplicação, não a password normal da conta
EMAIL_REMETENTE=
EMAIL_APP_PASSWORD=
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=465

# Categorização automática (LLM via Groq) — opcional; sem isto a categorização por LLM
# fica desligada e cai sempre no fallback
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# URL pública da app — único sítio a mudar quando fizeres deploy (usado no CORS e nos
# links enviados por email)
BASE_URL=http://localhost:8000
